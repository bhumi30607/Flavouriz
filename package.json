    "demo:fs": "node learning-examples/file-system.js",
    "demo:stream": "node learning-examples/file-stream.js",
    "demo:buffer": "node learning-examples/buffer-demo.js",
    "demo:event-loop": "node learning-examples/event-loop-demo.js",
    "demo:async-error": "node learning-examples/async-error-demo.js",
    "demo:modules:cjs": "node learning-examples/module-examples/commonjs-demo.cjs",
    "demo:modules:esm": "node learning-examples/module-examples/esmodule-demo.mjs"
