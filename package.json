  "description": "Flavouriz - Recipe Sharing & Cooking Community Platform (Full-Stack College Project)",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
